# ZORA web (Next.js)
# Backend origin the /api/* proxy + middleware forward to.
API_URL=http://localhost:4101

# White-label root domain (tenant subdomain detection in middleware).
ZORA_ROOT_DOMAIN=zora.com

# Optional PostHog product analytics. DB analytics remain canonical for revenue/ops.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
