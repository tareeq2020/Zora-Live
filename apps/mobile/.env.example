# Copy to mobile/.env. EXPO_PUBLIC_* vars are inlined into the app bundle by Expo.
#
# ZoraPass Nest API. Use your local machine IP for physical-device testing, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.8:4101
EXPO_PUBLIC_API_URL=http://localhost:4101

# ZoraPass web app. Used to build attendee split invite links from mobile.
# Use your local machine IP or tunnel URL for physical-device testing.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Optional PostHog product analytics. Financial/operational reporting stays in Zora DB analytics.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
